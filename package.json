{
  "name": "prism-vpn",
  "version": "1.0.0",
  "description": "Prism — гибкий VPN-клиент с TUN, системным прокси и маршрутизацией по приложениям",
  "main": "./out/main/index.js",
  "author": "Prism",
  "license": "MIT",
  "private": true,
  "scripts": {
    "setup": "node scripts/fetch-resources.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-validate.mjs && node scripts/run-e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "shots": "electron scripts/shoot.mjs",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:dir": "npm run build && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.0",
    "zustand": "^5.0.0"
  }
}
