<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Оба права выдаются только платному аккаунту Apple Developer: personal team
     их не поддерживает. В симуляторе они не проверяются, поэтому сборка и запуск
     там проходят, а на устройстве понадобится платная подписка. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<!-- Общая с расширением группа: через неё передаются конфиг и статистика -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.prism.vpn</string>
	</array>
</dict>
</plist>
